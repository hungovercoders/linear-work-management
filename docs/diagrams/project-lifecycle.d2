# Project lifecycle: how one project starts, graduates and delivers.
# Shown on the Projects page as a committed SVG (see `task diagrams`).
# Distinct from model.d2 (relationships): this is the flow through the states.
# Deliberately flat + acyclic (no nested containers, no back-edges) so the layout
# engine keeps it a clean vertical spine rather than tangling.

direction: down

# ---- discovery ----
idea: "Idea\nDISCOVERY · parentless & KR-less is fine · named lead from day one" {
  style: {fill: "#EEF1F7"; stroke: "#3D4C6B"; border-radius: 8; bold: true}
}
scoping: "Scoping\nDISCOVERY · cost & value under investigation" {
  style: {fill: "#EEF1F7"; stroke: "#3D4C6B"; border-radius: 8; bold: true}
}

# ---- the gate ----
gate: "«Planned gate» — discovery resolves into one of three" {
  style: {fill: "#FBF6EC"; stroke: "#B7791F"; border-radius: 8; bold: true; font-color: "#7A5312"}
}

# ---- the three outcomes ----
graduate: "GRADUATE\nlink an existing initiative, or seed a new one" {
  style: {fill: "#EEF1F7"; stroke: "#3D4C6B"; border-radius: 8; bold: true}
}
standalone: "STANDALONE\nno initiative — allowed, but questioned" {
  style: {fill: "#FCFCFD"; stroke: "#A9B2C4"; border-radius: 8}
}
drop: "DROP\nCanceled · reason recorded" {
  style: {fill: "#F8EDEE"; stroke: "#8C2F39"; border-radius: 8}
}

# ---- delivery ----
planned: "Planned\nDELIVERY · agreed, dated, resourced · names KR(s) + delta" {
  style: {fill: "#EEF1F7"; stroke: "#3D4C6B"; border-radius: 8; bold: true}
}
inprogress: "In Progress\nDELIVERY · being built  (Paused pauses here, with a reason)" {
  style: {fill: "#EEF1F7"; stroke: "#3D4C6B"; border-radius: 8; bold: true}
}
launching: "Launching\nDELIVERY · built · rolling out" {
  style: {fill: "#EEF1F7"; stroke: "#3D4C6B"; border-radius: 8; bold: true}
}

# ---- closed ----
completed: "Completed\nCLOSED · delivered AND the KR delta observed" {
  style: {fill: "#DCE9DC"; stroke: "#2F6B3A"; border-radius: 8; bold: true; font-color: "#1E4426"}
}

# ---- the spine (acyclic, top-to-bottom) ----
idea -> scoping -> gate
gate -> graduate {style.stroke: "#3D4C6B"}
gate -> standalone {style.stroke: "#A9B2C4"}
gate -> drop {style.stroke: "#8C2F39"}
graduate -> planned {style.stroke: "#3D4C6B"}
standalone -> planned {style.stroke: "#A9B2C4"}
planned -> inprogress -> launching -> completed
