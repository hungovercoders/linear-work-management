# Issue lifecycle: how one issue moves from arrival to done.
# Shown on the Issues overview page as a committed SVG (see `task diagrams`).
# Companion to project-lifecycle.d2. Flat + acyclic so the layout stays a clean vertical spine.
# Triage's five outcomes live on the Triage page (triage-outcomes.d2), not here.

direction: down

# ---- two entry points, converging on Backlog ----
# Triage is a state (inbound waits here for a decision); Project work is not a
# state, just where planned work enters — shown dashed to mark it an entry, not a state.
triage: "Triage\nunplanned work arrives here and waits for a decision" {
  style: {fill: "#F8EDEE"; stroke: "#8C2F39"; border-radius: 8; bold: true}
}
projectwork: "Project work\nplanned work is created straight in its project" {
  style: {fill: "#EEF1F7"; stroke: "#3D4C6B"; stroke-dash: 4; border-radius: 8; bold: true}
}

# ---- backlog: where both paths converge; the unmeasured pool ----
backlog: "Backlog\nwritten down, no promise yet · nobody is counting" {
  style: {fill: "#EEF1F7"; stroke: "#3D4C6B"; border-radius: 8; bold: true}
}

# ---- planning: committed to work up; the clock runs here ----
planning: "Planning\nthe team has committed and is working out the details" {
  style: {fill: "#FBF6EC"; stroke: "#B7791F"; border-radius: 8; bold: true; font-color: "#7A5312"}
}

# ---- ready and moving ----
todo: "Todo\nunderstood and ready to pick up" {
  style: {fill: "#EEF1F7"; stroke: "#3D4C6B"; border-radius: 8; bold: true}
}
inprogress: "In Progress\nbeing worked on" {
  style: {fill: "#EEF1F7"; stroke: "#3D4C6B"; border-radius: 8; bold: true}
}
inreview: "In Review\nfinished and being reviewed" {
  style: {fill: "#EEF1F7"; stroke: "#3D4C6B"; border-radius: 8; bold: true}
}

# ---- closed ----
done: "Done\nshipped and accepted" {
  style: {fill: "#DCE9DC"; stroke: "#2F6B3A"; border-radius: 8; bold: true; font-color: "#1E4426"}
}
dropped: "Canceled or Duplicate\nwon't be done, with the reason recorded" {
  style: {fill: "#FCFCFD"; stroke: "#8C2F39"; border-radius: 8}
}

# ---- the spine (acyclic, top-to-bottom) ----
triage -> backlog: accepted {style.stroke: "#8C2F39"}
projectwork -> backlog: created {style.stroke: "#3D4C6B"}
backlog -> planning: the team commits {style.stroke: "#B7791F"}
planning -> todo: it's ready {style.stroke: "#B7791F"}
todo -> inprogress -> inreview -> done
backlog -> dropped {style.stroke: "#A9B2C4"}
