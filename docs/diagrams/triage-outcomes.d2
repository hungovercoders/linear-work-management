# Triage outcomes: the five decisions the person on duty can make.
# Shown on the Triage work page as a committed SVG (see `task diagrams`).
# Companion to issue-lifecycle.d2. Flat + acyclic fan-out; BAU (red) palette.

direction: down

inbound: "Something arrives in Triage\nan incident, a request, a reported fault" {
  style: {fill: "#F8EDEE"; stroke: "#8C2F39"; border-radius: 8; bold: true}
}

decision: "Whoever is on duty decides\nat once for incidents, within a day or two otherwise" {
  style: {fill: "#FBF6EC"; stroke: "#B7791F"; border-radius: 8; bold: true; font-color: "#7A5312"}
}

# ---- the five outcomes ----
accept_project: "Accept into a project\nit becomes project work" {
  style: {fill: "#EEF1F7"; stroke: "#3D4C6B"; border-radius: 7; bold: true}
}
accept_bau: "Accept as BAU\none bau/* label, no project" {
  style: {fill: "#F8EDEE"; stroke: "#8C2F39"; border-radius: 7}
}
redirect: "Redirect\nto another team's Triage" {
  style: {fill: "#FCFCFD"; stroke: "#A9B2C4"; border-radius: 7}
}
merge: "Merge\nalready covered by another issue" {
  style: {fill: "#FCFCFD"; stroke: "#A9B2C4"; border-radius: 7}
}
decline: "Decline\nclosed, with a reason" {
  style: {fill: "#FCFCFD"; stroke: "#8C2F39"; border-radius: 7}
}

# ---- the fan-out (acyclic) ----
inbound -> decision
decision -> accept_project: {style.stroke: "#3D4C6B"}
decision -> accept_bau: {style.stroke: "#8C2F39"}
decision -> redirect: {style.stroke: "#A9B2C4"}
decision -> merge: {style.stroke: "#A9B2C4"}
decision -> decline: {style.stroke: "#8C2F39"}
