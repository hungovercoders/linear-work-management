# Canonical operating-model diagram. Edit this, not the rendered SVG.
# Rendered inline on the cheat sheet via Kroki (```kroki-d2```).
# Two paths, both flowing top-to-bottom through the ownership bands:
#   strategic:  INITIATIVE -> PROJECT -> ISSUE
#   external:   TRIAGE -> ISSUE (flow work)

grid-columns: 1
grid-gap: 70
direction: down

# ---------- STRATEGY band ----------
strategy: "STRATEGY  ·  leadership owns" {
  grid-rows: 1
  style: {fill: "#F7F8FB"; stroke: "#C7CDDA"; stroke-dash: 3; font-color: "#3D4C6B"}
  initiative: "INITIATIVE\nObjective + Key Results\nwhy it matters · how it's measured" {
    style: {fill: "#EEF1F7"; stroke: "#3D4C6B"; border-radius: 8; bold: true}
  }
}

# ---------- DELIVERY band ----------
delivery: "DELIVERY  ·  one named lead" {
  grid-rows: 1
  grid-gap: 90
  style: {fill: "#F7F8FB"; stroke: "#C7CDDA"; stroke-dash: 3; font-color: "#3D4C6B"}
  project: "PROJECT\nwhat we do and how · names one KR + the delta\none lead · milestones · dates · spend/*" {
    style: {fill: "#EEF1F7"; stroke: "#3D4C6B"; border-radius: 8; bold: true}
  }
  triage: "TRIAGE — the front door for unplanned work\n(arrives from outside · it breaks · is reported · is legally due)\nnamed duty rota · a decision on a clock · five outcomes" {
    style: {fill: "#F8EDEE"; stroke: "#8C2F39"; border-radius: 8; bold: true}
  }
}

# ---------- EXECUTION band ----------
execution: "EXECUTION  ·  teams own" {
  grid-rows: 1
  grid-gap: 60
  style: {fill: "#F7F8FB"; stroke: "#C7CDDA"; stroke-dash: 3; font-color: "#3D4C6B"}
  issue1: "ISSUE\ntype/feature" {
    style: {fill: "#EEF1F7"; stroke: "#3D4C6B"; border-radius: 7}
  }
  issue2: "ISSUE\ntype/spike · agent plan attached" {
    style: {fill: "#EEF1F7"; stroke: "#3D4C6B"; border-radius: 7}
  }
  flowissue: "ISSUE\nno project, and that's fine\nflow/vulnerability" {
    style: {fill: "#F8EDEE"; stroke: "#8C2F39"; border-radius: 7}
  }
}

# ---------- classification rule strip ----------
rule: "EVERY ISSUE IS CLASSIFIED — two ways are valid, two are failures" {
  grid-rows: 1
  grid-gap: 30
  style: {fill: "#FFFFFF"; stroke: "#DCE0E8"; font-color: "#1B2030"}
  ok_project: "✓ In a project\nplanned work" {
    style: {fill: "#EEF1F7"; stroke: "#3D4C6B"; border-radius: 7}
  }
  ok_flow: "✓ flow/*\ninbound work, no project" {
    style: {fill: "#F8EDEE"; stroke: "#8C2F39"; border-radius: 7}
  }
  bad_both: "✗ Both at once\npick one, drop the other" {
    style: {fill: "#FCFCFD"; stroke: "#A9B2C4"; border-radius: 7}
  }
  bad_neither: "✗ Neither\nunclassified · invisible work" {
    style: {fill: "#FCFCFD"; stroke: "#8C2F39"; stroke-width: 2; border-radius: 7}
  }
}

# ---------- strategic path (blue) ----------
strategy.initiative -> delivery.project: contains {style.stroke: "#3D4C6B"}
delivery.project -> execution.issue1: {style.stroke: "#3D4C6B"}
delivery.project -> execution.issue2: {style.stroke: "#3D4C6B"}

# ---------- external path (red) ----------
delivery.triage -> execution.flowissue: as flow work {style.stroke: "#8C2F39"}
