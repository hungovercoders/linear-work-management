# Canonical operating-model diagram. Edit this, not the rendered SVG.
# Shown on the Start here page as a committed SVG (see `task diagrams`).
# Two paths, both running top-to-bottom through the bands:
#   planned:  INITIATIVE -> PROJECT -> ISSUE
#   BAU:      TRIAGE -> ISSUE (bau/* label, no project)

grid-columns: 1
grid-gap: 60
direction: down

# ---------- why ----------
strategy: "WHY  ·  leadership" {
  label.near: top-left
  grid-rows: 1
  style: {fill: "#F7F8FB"; stroke: "#C7CDDA"; stroke-dash: 3; font-color: "#3D4C6B"; font-size: 20}
  initiative: "INITIATIVE\nAn outcome we want,\nand how we'll measure it" {
    style: {fill: "#E4EAF6"; stroke: "#3D4C6B"; border-radius: 8; bold: true; stroke-width: 2; font-size: 18}
  }
}

# ---------- how ----------
delivery: "HOW  ·  one named lead" {
  label.near: top-left
  grid-rows: 1
  grid-gap: 60
  style: {fill: "#F7F8FB"; stroke: "#C7CDDA"; stroke-dash: 3; font-color: "#3D4C6B"; font-size: 20}
  project: "PROJECT\nA piece of work that moves\none of those measures" {
    style: {fill: "#EEF1F7"; stroke: "#3D4C6B"; border-radius: 8; bold: true; font-size: 18}
  }
  triage: "TRIAGE\nWhere unplanned work arrives.\nWhoever is on duty decides where it goes" {
    style: {fill: "#F8EDEE"; stroke: "#8C2F39"; border-radius: 8; bold: true; font-size: 18}
  }
}

# ---------- the work ----------
execution: "THE WORK  ·  teams" {
  label.near: top-left
  grid-rows: 1
  grid-gap: 60
  style: {fill: "#F7F8FB"; stroke: "#C7CDDA"; stroke-dash: 3; font-color: "#3D4C6B"; font-size: 20}
  issue1: "ISSUE\ntype/feature" {
    style: {fill: "#EEF1F7"; stroke: "#3D4C6B"; border-radius: 7; font-size: 18}
  }
  issue2: "ISSUE\ntype/bug\ncame in through Triage" {
    style: {fill: "#EEF1F7"; stroke: "#3D4C6B"; border-radius: 7; font-size: 18}
  }
  bauissue: "ISSUE\nbau/incident\nstays BAU, no project" {
    style: {fill: "#F8EDEE"; stroke: "#8C2F39"; border-radius: 7; font-size: 18}
  }
}

# ---------- rule 3 ----------
rule: "Every issue belongs somewhere" {
  label.near: top-left
  grid-rows: 1
  grid-gap: 30
  style: {fill: "#FFFFFF"; stroke: "#DCE0E8"; font-color: "#1B2030"; font-size: 20}
  ok_project: "✓ In a project\nplanned work" {
    style: {fill: "#EEF1F7"; stroke: "#3D4C6B"; border-radius: 7; font-size: 17}
  }
  ok_bau: "✓ One bau/* label\nbusiness as usual" {
    style: {fill: "#F8EDEE"; stroke: "#8C2F39"; border-radius: 7; font-size: 17}
  }
  bad_both: "✗ Both\npick one" {
    style: {fill: "#FCFCFD"; stroke: "#A9B2C4"; border-radius: 7; font-size: 17}
  }
  bad_neither: "✗ Neither\nnobody can place it" {
    style: {fill: "#FCFCFD"; stroke: "#8C2F39"; stroke-width: 2; border-radius: 7; font-size: 17}
  }
}

# ---------- planned path (blue) ----------
strategy.initiative -> delivery.project: {style.stroke: "#3D4C6B"}
delivery.project -> execution.issue1: {style.stroke: "#3D4C6B"}
delivery.project -> execution.issue2: {style.stroke: "#3D4C6B"}

# ---------- BAU path (red) ----------
delivery.triage -> execution.issue2: {style: {stroke: "#8C2F39"; stroke-dash: 4}}
delivery.triage -> execution.bauissue: {style.stroke: "#8C2F39"}
